  network:
    '<rect x="9" y="2.5" width="6" height="6" rx="1.6"/><rect x="2.5" y="15.5" width="6" height="6" rx="1.6"/><rect x="15.5" y="15.5" width="6" height="6" rx="1.6"/><path d="M12 8.6v3.4M5.5 15.5V12h13v3.5"/>',
  shield: '<path d="M12 3.2 19.5 6v6c0 4-3 7.3-7.5 9-4.5-1.7-7.5-5-7.5-9V6L12 3.2Z"/>',
  zap: '<path d="M13.2 2.6 4.6 13.4H11l-.2 8 8.6-10.8H13l.2-8Z"/>',
