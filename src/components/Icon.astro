  sliders:
    '<path d="M4 6.5h8M17.5 6.5H20M4 12h4.5M14 12h6M4 17.5h8M17.5 17.5H20"/><circle cx="14.5" cy="6.5" r="2.3"/><circle cx="11" cy="12" r="2.3"/><circle cx="14.5" cy="17.5" r="2.3"/>',
  mic: '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.6 11a6.4 6.4 0 0 0 12.8 0"/><path d="M12 17.4V21M8.6 21h6.8"/>',
  'alert-triangle':
    '<path d="M10.3 4.4 2.7 17.5A2 2 0 0 0 4.4 20.5h15.2a2 2 0 0 0 1.7-3L13.7 4.4a2 2 0 0 0-3.4 0Z"/><path d="M12 9.6v4"/><path d="M12 17h.01"/>',
