const inner = ICONS[name] || ICONS.circle;
---

<svg
  class={['icon', className].filter(Boolean).join(' ')}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
  {...rest}
/>
