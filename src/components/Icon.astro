---
/**
 * Icon.astro — the platform's inline SVG icon set.
 *
 * Why a component instead of emoji: emoji render differently on every
 * OS, cannot inherit colour, and read poorly at small sizes. A single
 * stroke-based set (24×24 grid, currentColor, 1.75 stroke) keeps the
 * thousands of generated pages visually identical everywhere.
 *
 * Props:
 *   name   {string}  icon key (see ICONS below)
 *   size   {number}  px size, default 18
 *   stroke {number}  stroke width, default 1.75
 *   label  {string}  set when the icon is the only label of a control
 *   class  {string}
 */
const { name, size = 18, stroke = 1.75, label, class: className = '', ...rest } = Astro.props;

