  flask:
    '<path d="M9.5 3h5"/><path d="M10.5 3v5.4L5.3 18a2 2 0 0 0 1.8 3h9.8a2 2 0 0 0 1.8-3L13.5 8.4V3"/><path d="M7.6 14.5h8.8"/>',
  'help-circle':
