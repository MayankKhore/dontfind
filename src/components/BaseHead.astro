---
/**
 * BaseHead.astro — every SEO-relevant <head> tag in one place.
 *
 * Props:
 *   title       {string}  page title (brand suffix added automatically)
 *   description {string}  meta description (clamped to the SERP budget)
 *   path        {string}  canonical path (defaults to Astro.url.pathname)
 *   image       {string}  social share image path
 *   imageAlt    {string}  alt text for the share image
 *   noindex     {boolean} force noindex regardless of the policy
 *   ogType      {string}  'website' (default) or 'article'
 *   publishedTime {string}
 *   modifiedTime  {string}
 *
 * The robots directive is resolved from indexingFor() so a page can never
 * accidentally ship index, follow on a route the policy reserves.
 */
import { buildMeta, SOCIAL } from '../lib/seo.js';
import { indexingFor } from '../config/seo.config.mjs';

const {
  title,
  description,
  path,
  image,
  imageAlt,
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  collection,
} = Astro.props;

const canonicalPath = path || Astro.url.pathname;
const meta = buildMeta({ title, description, path: canonicalPath, image, imageAlt, ogType, publishedTime, modifiedTime, collection });

// Policy first, explicit prop as the override.
const policy = indexingFor(canonicalPath);
const isIndexable = noindex ? false : policy.index;
const robots = `${isIndexable ? 'index' : 'noindex'}, follow`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={meta.canonical} />
<meta name="robots" content={robots} />
{/* Ask for the largest image preview and an unclipped snippet. */}
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="generator" content={Astro.generator} />

<!-- Match the address bar / OS chrome to the active palette. -->
<meta name="theme-color" content="#090e15" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
<meta name="color-scheme" content="dark light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href={meta.image} />

<!--
  Apply the stored theme BEFORE first paint. This tiny inline script is the
  only way to avoid a flash of the wrong palette; it is intentionally
  duplicated in a blocking way rather than deferred.
-->
<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('ccna_path_theme');
      var theme =
        stored === 'light' || stored === 'dark'
          ? stored
          : window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  })();
</script>

<!-- Open Graph -->
<meta property="og:type" content={meta.ogType} />
<meta property="og:site_name" content={meta.sectionLabel} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:image" content={meta.image} />
<meta property="og:image:width" content={String(meta.imageWidth)} />
<meta property="og:image:height" content={String(meta.imageHeight)} />
<meta property="og:image:alt" content={meta.imageAlt} />
{meta.publishedTime && <meta property="article:published_time" content={meta.publishedTime} />}
{meta.modifiedTime && <meta property="article:modified_time" content={meta.modifiedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SOCIAL.twitter} />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.image} />
<meta name="twitter:image:alt" content={meta.imageAlt} />

