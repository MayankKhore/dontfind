---
/**
 * Badge.astro — small status/label pill.
 *
 * Props:
 *   variant  difficulty ('beginner'|'intermediate'|'advanced') or a status
 *            ('stage'|'draft'|'success'|'danger'|'info'|'neutral'|'count')
 *   label    text (or use the default slot)
 *   icon     Icon name shown before the label
 *
 * Difficulty variants are also the platform's learning-level colours, so
 * a badge always means the same thing wherever it appears.
 */
import Icon from './Icon.astro';

const { variant = '', label, icon, class: className = '' } = Astro.props;
const cls = ['badge', variant && `badge--${variant}`, className].filter(Boolean).join(' ');
---
<span class={cls}>
  {icon && <Icon name={icon} size={13} />}
  <slot>{label}</slot>
</span>
