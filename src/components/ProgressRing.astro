---
/**
 * ProgressRing.astro — radial progress for the dashboard.
 *
 * Server-renders a real value (so the page is useful without JS) and
 * exposes `--_pct` so progress.js can animate it later.
 *
 * Props: value, max, label, caption, size, thickness
 */
const {
  value = 0,
  max = 100,
  label = 'Progress',
  caption,
  size = 132,
  thickness = 10,
  attrs = {},
} = Astro.props;

const pct = max > 0 ? Math.max(0, Math.min(100, Math.round((value / max) * 100))) : 0;
const radius = (size - thickness) / 2;
const circumference = 2 * Math.PI * radius;
---

<div
  class="ring"
  style={`--_pct:${pct};--_circ:${circumference.toFixed(2)};width:${size}px;height:${size}px`}
  role="progressbar"
  aria-valuenow={value}
  aria-valuemin="0"
  aria-valuemax={max}
  aria-label={`${label}: ${pct}%`}
  data-ring
  {...attrs}
>
  <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} aria-hidden="true">
    <circle class="ring__track" cx={size / 2} cy={size / 2} r={radius} />
    <circle
      class="ring__value"
      cx={size / 2}
      cy={size / 2}
      r={radius}
      style={`stroke-dasharray:${circumference.toFixed(2)};stroke-dashoffset:${(
        circumference -
        (circumference * pct) / 100
      ).toFixed(2)}`}
    />
  </svg>
  <span class="ring__label">
    <span class="ring__value-text" data-ring-text>{pct}%</span>
    {caption && <span class="ring__caption">{caption}</span>}
  </span>
</div>
