---
/**
 * ProgressIndicator.astro — accessible linear progress bar.
 * Props: value (0..max), max, label, showText, size ('sm'|'lg')
 */
const { value = 0, max = 100, label = 'Progress', showText = false, size = '' } = Astro.props;
const pct = max > 0 ? Math.min(100, Math.round((value / max) * 100)) : 0;
const cls = ['progress', size && `progress--${size}`].filter(Boolean).join(' ');
---

<div class="progress-block" role="group" aria-label={label}>
  {showText && (
    <p class="progress-block__row">
      <span>{label}</span>
      <span class="u-tabular">{pct}%</span>
    </p>
  )}
  <div
    class={cls}
    role="progressbar"
    aria-valuenow={value}
    aria-valuemin="0"
    aria-valuemax={max}
    aria-label={label}
    style={`--_pct:${pct}%`}
  >
    <span class="progress__fill"></span>
  </div>
</div>
