---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CollectionBrowser from '../../components/CollectionBrowser.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { published, uniqueValues } from '../../lib/content.js';

const terms = published(await getCollection('glossary'));
const categories = uniqueValues(terms, 'category');

const items = terms.map((term) => ({
  href: `/glossary/${term.id}/`,
  title: term.data.term,
  kicker: term.data.acronymFor || term.data.category,
  description: term.data.definition,
  icon: 'book-open',
  category: term.data.category,
  searchText: [term.data.term, term.data.acronymFor, term.data.definition]
    .filter(Boolean)
    .join(' '),
}));

const breadcrumbs = [
  { href: '/', label: 'Home' },
  { label: 'Glossary' },
];
---

<BaseLayout
  title="Networking Glossary"
  description="A clear, growing glossary of networking terms, acronyms and protocols — written in plain English for CCNA students."
  path="/glossary/"
  breadcrumbs={breadcrumbs}
>
  <div class="container container--wide">
    <PageHeader
      kicker={`${terms.length} terms`}
      icon="book-open"
      title="Networking glossary"
      lead="Plain-English definitions of every protocol, acronym and term you will meet — on this platform and in the exam."
    >
      <div slot="actions" class="cluster">
        <Button href="/search/" variant="primary">
          <Icon name="search" size={16} />
          <span>Search everything</span>
        </Button>
      </div>
    </PageHeader>

    <CollectionBrowser
      items={items}
      noun="terms"
      label="Search glossary"
      placeholder="Search terms — try “ARP”, “VLAN” or “subnet”…"
      emptyTitle="No terms match"
      emptyText="Nothing matched that search. Try the acronym, e.g. “ARP” or “DNS”."
      filters={[{ key: 'category', label: 'Category', options: categories }]}
    />
  </div>
</BaseLayout>